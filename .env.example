# Copy to .env (gitignored) and fill in. Exported shell variables take precedence.

# Penpot → Your account → Integrations → MCP Server → MCP key
PENPOT_MCP_KEY=
# Optional: only for self-hosted Penpot (default https://design.penpot.app/mcp/stream)
# PENPOT_MCP_URL=https://penpot.example.com/mcp/stream

# Foundry image MCP server (.github/mcp/foundry-image) — auth via `az login` (Microsoft Entra ID)
# Resource endpoint: https://<resource>.services.ai.azure.com (a Foundry project URL also works)
FOUNDRY_ENDPOINT=
# Comma-separated deployment names; first is the default. API family is inferred
# (names starting with "mai" -> mai, otherwise openai) or set explicitly: name=mai|openai
FOUNDRY_IMAGE_MODELS=
# Optional: tenant of the Foundry resource if it differs from your default `az login` tenant
# FOUNDRY_TENANT_ID=
# Optional: API key instead of Entra ID (not recommended)
# FOUNDRY_API_KEY=
# Optional: default folder for generated images (workspace-relative, gitignored)
# FOUNDRY_IMAGE_OUTPUT_DIR=.generated-images
